{
  "expo": {
    "name": "VisioWhiteboard",
    "slug": "visio-whiteboard",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a1a2e"
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tonnom.visiowhiteboard",
      "infoPlist": {
        "NSCameraUsageDescription": "Nécessaire pour la visioconférence",
        "NSMicrophoneUsageDescription": "Nécessaire pour l'audio de la visioconférence"
      }
    },
    "android": {
      "package": "com.tonnom.visiowhiteboard",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "896eeb2d-ea34-4940-9e19-451d13a3c748"
      }
    }
  }
}
